<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain http only to this machine: the laptop dev gateway on 127.0.0.1.
		     PrismKit's ServerOrigin refuses http to any other host, and refuses it
		     entirely in an iOS release build. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleURLTypes</key>
    <array><dict><key>CFBundleURLSchemes</key><array><string>omni</string></array></dict></array>
	<key>NSFaceIDUsageDescription</key>
	<string>Omni uses Face ID to unlock private conversations and confirm actions you approve.</string>
	<key>NSMicrophoneUsageDescription</key><string>Record local speech benchmark utterances on this device.</string>
	<key>NSSpeechRecognitionUsageDescription</key><string>Compare Apple on-device speech transcription with your corrected benchmark recordings.</string>
</dict>
</plist>
