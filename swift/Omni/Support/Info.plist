<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain http only to this machine: the laptop dev gateway on 127.0.0.1.
		     PrismKit's ServerOrigin refuses http to any other host, and refuses it
		     entirely in an iOS release build. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Omni asks for Face ID before it sends anything on your behalf.</string>
</dict>
</plist>
