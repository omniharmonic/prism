{
  "name": "prism-monorepo",
  "private": true,
  "version": "0.9.0",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid@3": "3.3.20",
      "immutable": "^4.3.9"
    },
    "lodash-es": "^4.18.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @prism/desktop",
    "build": "npm run build -w @prism/desktop",
    "preview": "npm run preview -w @prism/desktop",
    "tauri": "npm run tauri -w @prism/desktop --",
    "typecheck": "npm run typecheck -w @prism/core && npm run typecheck -w @prism/desktop && npm run typecheck -w @prism/web && npm run typecheck -w @prism/server && npm run typecheck -w @prism/push-relay",
    "typecheck:e2e": "npm run typecheck:e2e -w @prism/web",
    "check": "npm run check:version && npm run typecheck && npm run typecheck:e2e && npm run check:dialogs -w @prism/web --if-present && npm run check:sw -w @prism/web && npm run check:initial -w @prism/web",
    "test": "npm run test -w @prism/server && npm run test -w @prism/push-relay",
    "setup": "npm run setup:full -w @prism/server",
    "build:host": "node --import tsx packaging/host/build.ts",
    "check:version": "node scripts/version.mjs check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.97.0",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/extension-code-block-lowlight": "~3.30.6",
    "@tiptap/extension-collaboration": "~3.30.6",
    "@tiptap/extension-collaboration-caret": "~3.30.6",
    "@tiptap/extension-highlight": "~3.30.6",
    "@tiptap/extension-image": "~3.30.6",
    "@tiptap/extension-link": "~3.30.6",
    "@tiptap/extension-table": "~3.30.6",
    "@tiptap/extension-table-cell": "~3.30.6",
    "@tiptap/extension-table-header": "~3.30.6",
    "@tiptap/extension-table-row": "~3.30.6",
    "@tiptap/extension-task-item": "~3.30.6",
    "@tiptap/extension-task-list": "~3.30.6",
    "@tiptap/extension-typography": "~3.30.6",
    "@tiptap/pm": "~3.30.6",
    "@tiptap/react": "~3.30.6",
    "@tiptap/starter-kit": "~3.30.6",
    "@tiptap/y-tiptap": "3.0.7",
    "autoprefixer": "^10.4.27",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.17",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-3d": "^1.29.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "use-debounce": "^10.1.1",
    "yjs": "^13.6.31",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
