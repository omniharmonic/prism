<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ad hoc export for the DEVICE PASS (docs/client-app.md "Owner procedure"): a Release build on
     production APNs, installed straight onto registered test devices — nothing is uploaded.
     Manual signing: local Apple Distribution identity + an Ad Hoc profile named
     "Prism Workspace Ad Hoc" that lists the test devices' UDIDs (created once in the developer
     portal). Used by apps/client/scripts/ios-release.sh -adhoc. -->
<plist version="1.0">
<dict>
	<key>method</key><string>release-testing</string>
	<key>destination</key><string>export</string>
	<key>teamID</key><string>83Y42N33H8</string>
	<key>signingStyle</key><string>manual</string>
	<key>signingCertificate</key><string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.benjaminlife.prism.client</key><string>Prism Workspace Ad Hoc</string>
	</dict>
</dict>
</plist>
