<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into gen/apple/prism-client_iOS/Info.plist on every iOS build (WP5). -->
<plist version="1.0">
<dict>
	<!-- Home-screen name; the App Store name ("Prism Workspace") lives in App Store Connect. -->
	<key>CFBundleDisplayName</key>
	<string>Prism</string>
	<!-- Only standard HTTPS/TLS (Apple's exemption): no export-compliance documents needed. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The optional app lock (Settings → Security). -->
	<key>NSFaceIDUsageDescription</key>
	<string>Prism uses Face ID to unlock your workspace when you turn on the app lock.</string>
	<!-- ATS stays on for every remote host. Local-network/loopback addresses only, so a
	     test Prism Server on http://127.0.0.1 works in the simulator; the shell itself only
	     ever accepts http:// for loopback (origin.rs). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
