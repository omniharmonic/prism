# Prism Server configuration — copy to `.env` and fill in.
# Easiest: run `npm run setup` (scripts/bootstrap.sh) to generate the secrets.
# NEVER commit `.env`. It holds the keys to the entire vault.

# ── Public origin ───────────────────────────────────────────────────────────
# The https URL the server is reached at (your Cloudflare tunnel hostname).
# Drives Secure cookies, HSTS, and the share-link domain. Use http://localhost:8787
# only for local-only testing (cookies won't be Secure).
APP_ORIGIN=https://prism.example.com
PORT=8787

# ── Parachute vault (the data) ──────────────────────────────────────────────
PARACHUTE_URL=http://localhost:1940
PARACHUTE_VAULT=default
# Hub-issued JWT with write scope. Mint with:
#   parachute auth mint-token --scope vault:default:write --expires-in 31536000
# This is the most sensitive secret here — full vault access. Server-only.
PARACHUTE_TOKEN=

# ── Secrets (generate strong random values — `openssl rand -base64 48`) ──────
# Signs session cookies. Rotating it logs everyone out.
SESSION_SECRET=
# Signs capability (share) links. Rotating it invalidates all outstanding links.
CAPABILITY_SECRET=
# Dedicated owner token for the desktop app's real-time + share connection.
# Put this SAME value in the desktop config (collab_token). Honored ONLY from
# localhost — useless if presented over the public tunnel. `openssl rand -base64 30`
COLLAB_TOKEN=

# ── Owner identity ──────────────────────────────────────────────────────────
# The one account with full vault access + the ability to issue invites and sign
# in via magic link. Everyone else is invite-only.
OWNER_EMAIL=you@example.com

# ── Email (magic links + invites) ───────────────────────────────────────────
# Resend API key. REQUIRED in production, or magic links/invites only log to the
# console (dev-only). The MAGIC_FROM sender must be on a Resend-verified domain.
RESEND_API_KEY=
MAGIC_FROM=Prism <login@example.com>

# ── Storage / paths ─────────────────────────────────────────────────────────
DB_PATH=./prism-server.db
WEB_ROOT=../web/dist

# ── Semantic search (RAG) ───────────────────────────────────────────────────
# Embeddings power /api/search/semantic (hybrid vector + full-text). With no
# EMBED_ENDPOINT the server falls back to a deterministic offline embedder
# (lexical, not semantic) — the pipeline still runs. For real semantic search,
# point this at any OpenAI-compatible /v1 embeddings endpoint (Ollama, LM Studio,
# llama.cpp, or a hosted API). The Rust backend's indexer uses the SAME model so
# document and query vectors are comparable.
# EMBED_ENDPOINT=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=
EMBED_FALLBACK_DIM=384

# ── ClickUp task sync ───────────────────────────────────────────────────────
# How often the worker may pull ClickUp tasks (ms). 0 disables the scheduled
# pull; the API key itself is entered via /api/integrations/clickup, not here.
CLICKUP_INTERVAL_MS=300000

# Matrix: accept pending room invites. mautrix bridges INVITE the sync user to
# every new chat portal; an un-joined room never appears in /sync, so its
# messages are silently dropped. Off by default because a long-lived bridge can
# have a 1000+ portal backlog and each join creates a thread note. Throttled.
# MATRIX_AUTO_JOIN=true
# MATRIX_AUTO_JOIN_PER_RUN=10

# Matrix: link each message-thread note to its participants' person notes
# (`messages-with`), as the desktop message_sync did. Off by default — it can
# create person notes (DMs of <=3 members only). See CLAUDE.md.
# MATRIX_LINK_PEOPLE=true

# ── Gmail ingest (Architecture v2 WP1.2) ─────────────────────────────────────
# Server-side port of the desktop email_sync (via the co-located `gog` CLI).
# NEVER enable while the desktop's email sync runs: set `disable_email_sync=true`
# in the desktop prism-config.json first. The account comes from the `google`
# credential ({"account": "..."}) via /api/integrations/google, not from here.
# GMAIL_SYNC_ENABLED=true
# GMAIL_INTERVAL_MS=180000
