{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "src",
    "test",
    "scripts",
    "../../packaging/host/cli",
    "../../packaging/host/build",
    "../../packaging/host/build.ts",
    "../../packaging/host/smoke.ts"
  ]
}
