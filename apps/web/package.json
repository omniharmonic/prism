{
  "name": "@prism/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-no-browser-dialogs.mjs && node scripts/check-clipboard.mjs && tsc && vite build && node scripts/check-sw-denylist.mjs --built",
    "build:native": "tsc && vite build --mode native",
    "verify:native": "node scripts/verify-native-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "check:sw": "node scripts/check-sw-denylist.mjs",
    "check:dialogs": "node scripts/check-no-browser-dialogs.mjs",
    "check:clipboard": "node scripts/check-clipboard.mjs",
    "verify:agent": "node --import tsx scripts/verify-agent-reducer.ts",
    "verify:events": "node --import tsx scripts/verify-events.ts",
    "verify:search": "node --import tsx scripts/verify-search-blend.ts",
    "verify:sync": "node --import tsx scripts/verify-sync-state.ts",
    "verify:session": "node --import tsx scripts/verify-session.ts",
    "verify:host": "node --import tsx scripts/verify-host-services.ts",
    "verify:media": "node --import tsx scripts/verify-media-proxy.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "check:scripts": "node scripts/check-scripts.mjs",
    "perf": "playwright test -c playwright.perf.config.ts",
    "perf:bundle": "node scripts/perf-bundle.mjs",
    "perf:graph": "node scripts/perf-static-graph.mjs",
    "check:initial": "node scripts/perf-static-graph.mjs --assert-lazy node_modules/@tiptap/,node_modules/prosemirror-,node_modules/yjs/,node_modules/@hocuspocus/,node_modules/highlight.js/,node_modules/lowlight/,node_modules/maplibre-gl/,node_modules/@excalidraw/",
    "build:brand": "node --import tsx scripts/build-brand.ts",
    "test:native-ui": "npm run build:native && playwright test --config playwright.native.config.ts"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.1.0",
    "@prism/core": "*",
    "marked": "^14.1.4",
    "turndown": "^7.2.0",
    "y-indexeddb": "^9.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@types/turndown": "^5.0.5",
    "vite-plugin-pwa": "^1.3.0"
  }
}
