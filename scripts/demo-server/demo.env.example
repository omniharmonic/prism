# The App Review demo server's settings. Copy to ~/demo.env as the DEMO macOS user
# (cp scripts/demo-server/demo.env.example ~/demo.env; chmod 600 ~/demo.env) and fill in
# DEMO_HOST. Nothing here is a secret; secrets live only in the demo install's config/.env.
# Every script sources this file (DEMO_ENV=<path> to use another one).

# The macOS user the demo runs as. The scripts refuse to run as anyone else.
DEMO_USER=prism-demo

# The demo's own install root (prism install --prefix) and its own Parachute data
# (PARACHUTE_HOME). Never the production prefix, never ~/.parachute.
DEMO_PREFIX="$HOME/PrismDemo/Host"
DEMO_PARACHUTE_HOME="$HOME/PrismDemo/parachute"

# Ports — all on 127.0.0.1, none of them production's (Parachute hub 1939, vault 1940,
# Prism Server 8787; the scripts refuse those).
DEMO_SERVER_PORT=18787
DEMO_HUB_PORT=18939
DEMO_VAULT_PORT=18940
DEMO_VAULT_NAME=demo

# The public name the Cloudflare tunnel serves (https). App Review types it on the app's
# first-run screen. A subdomain of the publisher's domain, e.g. demo.<your domain>.
DEMO_HOST=demo.example.com

# The demo server's owner (signs in only on the demo host itself, with `prism signin`;
# no mail is ever sent there) and the App Review account (a workspace member).
DEMO_OWNER_EMAIL=demo-owner@example.com
DEMO_REVIEWER_EMAIL=app-review@example.com
DEMO_REVIEWER_NAME="App Review"

# The host bundle the demo runs: an unpacked prism-host-<version>-darwin-arm64 folder
# (its runtime/node runs the kit's .mjs scripts too).
DEMO_BUNDLE="$HOME/prism-host"

# Stock Parachute for the demo user (bun add -g @openparachute/hub@0.7.19 @openparachute/vault@0.7.9).
PARACHUTE_BIN="$HOME/.bun/bin/parachute"
PARACHUTE_VAULT_BIN="$HOME/.bun/bin/parachute-vault"

# launchd label of the demo's Parachute hub agent (gui/<demo uid> domain).
DEMO_PARACHUTE_LABEL=local.prism-demo.parachute
