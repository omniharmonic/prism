<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Parachute hub, owned by Prism. Stock mode (the launch plan's fallback): `prism run hub` runs the
  agent-installed stock `parachute serve` in the foreground (loopback, port 1939; its supervisor runs
  the vault). Embedded mode: the bundled payload, once it ships.
  Generated by `prism install` from packaging/host/launchd/hub.plist.in. Do not edit:
  `prism install` / `prism update` rewrite it. No secret is ever written here — the
  supervisor reads the install's .env (0600) itself.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{PRISM_BIN}}</string>
    <string>run</string>
    <string>hub</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PRISM_HOME</key>
    <string>{{PRISM_HOME}}</string>
    <key>PATH</key>
    <string>{{PATH}}</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>{{WORKING_DIR}}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>{{THROTTLE}}</integer>
  <key>ExitTimeOut</key>
  <integer>20</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/hub.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/hub.launchd.log</string>
</dict>
</plist>
